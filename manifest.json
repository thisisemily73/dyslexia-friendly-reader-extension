{
  "manifest_version": 3,
  "name": "DyslexiView: Dyslexia Reader & TTS",
  "version": "1.0.0",
  "description": "A Chrome extension to assist users with dyslexia by providing text-to-speech functionality and customizable reading settings.",
  "author": "Emily Lopez",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "logo/DV-16x16.png",
    "32": "logo/DV-32x32.png",
    "48": "logo/DV-48x48.png",
    "128": "logo/DV-128x128.png"
  }
}